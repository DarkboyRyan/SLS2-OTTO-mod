; OTTO 的战斗能量计数器。人物图等比完整显示，能量数字由 BaseLib 自动生成。
; 控件均忽略鼠标事件，不会遮挡战斗界面的交互。
[gd_scene load_steps=2 format=3]

[ext_resource type="Texture2D" path="res://OTTO/images/ui/otto_energy.png" id="1_energy"]

[node name="OttoEnergyCounter" type="Control"]
custom_minimum_size = Vector2(128, 128)
offset_right = 128.0
offset_bottom = 128.0
mouse_filter = 2

[node name="Layers" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Icon" type="TextureRect" parent="Layers"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("1_energy")
expand_mode = 1
stretch_mode = 5
